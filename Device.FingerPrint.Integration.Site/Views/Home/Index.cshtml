@model SubscriberModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center row">
    <div class="col-md-12">
        <section>
            <form method="post" role="form" class="form-horizontal" action="@Url.Action("OnPost")">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="d-flex">
                    <div class="font-weight-bold align-self-center">
                        Choose Subscriber:
                    </div>
                    <div class="ml-2">
                        @Html.DropDownListFor(m => m.SubscriberId, ViewBag.SubscriberList as SelectList, new { @class = "form-control" })
                    </div>
                    <div class="ml-2">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>
            </form>
            <form name="FrontEndForm">
                <div class="d-flex mt-2 control-label text-left border bg-info">
                    <div class="mr-auto p-2 text-white">
                        Front-end
                    </div>
                    <div class="p-2">
                        <input name="button" onclick="javascript:this.form.FrontEnd.focus();this.form.FrontEnd.select();" type="button" value="Select all" />
                    </div>
                </div>
                @Html.TextArea("FrontEnd", ViewBag.FrontEnd as String, new { @class = "form-control", @readonly = "readonly" })

                <div class="d-flex mt-2 control-label text-left border bg-info">
                    <div class="mr-auto p-2 text-white">
                        Back-end
                    </div>
                    <div class="p-2">
                        <input name="button" onclick="javascript:this.form.BackEnd.focus();this.form.BackEnd.select();" type="button" value="Select all" />
                    </div>
                </div>
                @Html.TextArea("BackEnd", ViewBag.BackEnd as String, new { @class = "form-control", @rows = 10, @readonly = "readonly" })
            </form>
        </section>
    </div>
</div>
