<script async="" defer="" src="//sc.detecas.com/di/activator.ashx"></script>

<script>
    function scrollToSection(sectionId) {
        var section = document.getElementById(sectionId);
        window.scrollTo({
            top: section.offsetTop - 20,
            behavior: 'smooth'
        });
    }

    window.onload = function () {
        var sessionKeyElement = document.getElementById("id-session-key");

        var fdiValueElement = document.getElementById("__fdi");
        var diHiddenElement = document.getElementById("__di");
        var biHiddenElement = document.getElementById("__bi");
        var detecasAnalysisElement = document.getElementById("detecas-analysis");
        var userAgentElement = document.getElementById("id-user-agent");

        if (sessionKeyElement && fdiValueElement) {
            sessionKeyElement.innerHTML = fdiValueElement.value;
        }
        if (userAgentElement) {
            userAgentElement.innerHTML = navigator.userAgent;
        }

        var contentElement = document.getElementById("id-code-content");
        if (contentElement) {
            var contentHtml = contentElement.innerHTML;

            if (diHiddenElement) {
                contentHtml = contentHtml.replace("__di__", diHiddenElement.value);
            }
            if (biHiddenElement) {
                contentHtml = contentHtml.replace("__bi__", biHiddenElement.value);
            }
            if (detecasAnalysisElement) {
                contentHtml = contentHtml.replace("__detecasAnalysis__", detecasAnalysisElement.value);
            }
            if (fdiValueElement) {
                contentHtml = contentHtml.replace("__sessionKey__", fdiValueElement.value);
            }

            contentHtml = contentHtml.replace("__useragent__", navigator.userAgent);
            contentHtml = contentHtml.replace("__url__", window.location.href);
            contentElement.innerHTML = contentHtml;
        }
    };
</script>

@* Get IP Address by RTCPeerConnection *@
<script>
    function getLocalIP() {
        return new Promise((resolve, reject) => {
            const peerConnection = new c();
            peerConnection.createDataChannel("");

            peerConnection.createOffer()
                .then(offer => peerConnection.setLocalDescription(offer))
                .catch(error => reject(error));

            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    // Trích xuất địa chỉ IP từ chuỗi candidate
                    const ipRegex = /([0-9]{1,3}(\.[0-9]{1,3}){3})/;
                    const match = ipRegex.exec(event.candidate.candidate);

                    if (match && match[1]) {
                        const ipAddress = match[1];
                        resolve(ipAddress);
                    } else {
                        // Xử lý trường hợp không thể trích xuất địa chỉ IP
                        reject(new Error('Không thể trích xuất địa chỉ IP từ candidate.'));
                    }
                } else {
                    // Quá trình ICE đã hoàn tất, không còn candidates nữa
                    resolve(null);
                }
            };
        });
    }

    // Hiển thị địa chỉ IP sau khi lấy được
    getLocalIP()
        .then(ipAddress => {
            if (ipAddress) {
                console.log('ipAddress', ipAddress);
                // var ipAddressElement = document.getElementById("ip-address");
                // ipAddressElement.textContent = ipAddress;
            } else {
                console.log('Không còn candidate ICE nữa.');
            }
        })
        .catch(error => console.error('Lỗi khi lấy địa chỉ IP:', error));
</script>