<div class="container-fluid">
    <div class="row">
        <div class="col-2 px-1 bg-dark position-fixed" id="sticky-sidebar">
            <div class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

                <div class="sidebar-brand d-flex align-items-center justify-content-center">
                    <div class="sidebar-brand-text mx-3">FPS Integration Site</div>
                </div>

                <hr class="sidebar-divider">

                <div class="sidebar-heading cursor-pointer pb-2" onclick="scrollToSection('section-1')">
                    Front-end
                </div>
                <!-- Divider -->
                <hr class="sidebar-divider">

                <!-- Heading -->
                <div class="sidebar-heading cursor-pointer" onclick="scrollToSection('section-2')">
                    Back-end
                </div>

                <li class="nav-item">
                    <div class="nav-link cursor-pointer" onclick="scrollToSection('section-2')">
                        <i class="fas fa-angle-double-right"></i>
                        <span>.Net Standard</span>
                    </div>
                    <div class="nav-link cursor-pointer" onclick="scrollToSection('section-3')">
                        <i class="fas fa-angle-double-right"></i>
                        <span>.Net Core</span>
                    </div>
                    <div class="nav-link cursor-pointer" onclick="scrollToSection('section-4')">
                        <i class="fas fa-angle-double-right"></i>
                        <span>.Net Framework</span>
                    </div>
                </li>

                <!-- Divider -->
                <hr class="sidebar-divider d-none d-md-block">

                <!-- Sidebar Toggler (Sidebar) -->
                <div class="text-center d-none d-md-inline">
                    <button class="rounded-circle border-0" id="sidebarToggle"></button>
                </div>

            </div>
        </div>
        <div class="col-10 offset-2" id="main">
            <div id="content-wrapper" class="d-flex flex-column">
                <div id="content" class="h-100 d-inline-block">
                    <div class="container-fluid">

                        <section id="section-1">
                            <h1 class="h3 my-3 text-gray-800">Front-end</h1>
                        </section>
                        <section>
                            <div class="row">
                                <div class="card shadow mb-4 w-100">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-primary">Html</h6>
                                    </div>
                                    <div class="card-body">
                                        <pre class="tag-pre"><code class="language-javascript">&lt;script type="text/javascript" src="{activatorLink}" async="" defer=""&gt;&lt;/script&gt;</code></pre>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <p class="col-12">
                                    With <span class="text-primary">{activatorLink}</span> is:
                                </p>
                                <ul>
                                    <li>
                                        PROD: <span class="text-primary">//sc.detecas.com/di/activator.ashx</span>
                                    </li>
                                    <li>
                                        UAT: <span class="text-primary">//scqa2.detecas.com/activator.ashx</span>
                                    </li>
                                    <li>
                                        LOCAL: <span class="text-primary">//fps-di.nexdev.net/activator.ashx</span>
                                    </li>
                                </ul>
                            </div>
                        </section>

                        <hr/>
                        <section id="section-2">
                            <h1 class="h3 my-3 text-gray-800">Back-end</h1>
                        </section>
                        <section>
                            <div class="row">
                                <p class="col-12">
                                    Install/Update new SDK
                                </p>
                                <p class="col-12">
                                    Change to new code
                                </p>
                            </div>
                            <div class="row">
                                <div class="card shadow mb-4 w-100">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-primary">.Net Standard</h6>
                                    </div>
                                    <div class="card-body">
                                        <pre class="tag-pre">
                                        <code class="language-javascript">
var fpsClient = new FPS.Client.NetStandard.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
                                    </div>
                                </div>
                            </div>
                        </section>


                        <section id="section-3">
                            <div class="row">
                                <div class="card shadow mb-4 w-100">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-primary">.Net NetCore</h6>
                                    </div>
                                    <div class="card-body">
                                        <pre class="tag-pre">
                                        <code class="language-javascript">
var fpsClient = new FPS.Client.NetCore.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section id="section-4">
                            <div class="row">
                                <div class="card shadow mb-4 w-100">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-primary">.Net Framework</h6>
                                    </div>
                                    <div class="card-body">
                                        <pre class="tag-pre">
                                        <code class="language-javascript">
var fpsClient = new FPS.Client.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <div class="row">
                            <p class="col-12">
                                With <span class="text-primary">{fpsAPI}</span> is:
                            </p>
                            <ul>
                                <li>
                                    PROD (internal network): <span class="text-primary">http://fpsapi.nebula.prod/</span>
                                </li>
                                <li>
                                    UAT (internal network): <span class="text-primary">http://api-uat.nebula.prod/api.detecas.com/</span>
                                </li>
                                <li>
                                    PROD (external network): <span class="text-primary">http://api.detecas.com/</span>
                                </li>
                                <li>
                                    UAT (external network): <span class="text-primary">http://scqa1.detecas.com/api.detecas.com/</span>
                                </li>
                                <li>
                                    LOCAL: <span class="text-primary">https://fps-newapi.nexdev.net/</span>
                                </li>
                            </ul>
                        </div>

                        <div class="row">
                            <p class="col-12">
                                And parameters:
                            </p>
                            <ul>
                                <li>
                                    <span class="text-primary">{loginName}</span>: The username that the client uses to log in.
                                </li>
                                <li>
                                    <span class="text-primary">{subscriberName}</span>: The licensee’s name that provided by FPS team.
                                </li>
                                <li>
                                    <span class="text-primary">{action}</span>: The action where fps integrated (login, deposit, withdraw, etc.).
                                </li>
                                <li>
                                    <span class="text-primary">{loginTime}</span>: The time when the client logged in successfully.
                                </li>
                            </ul>
                        </div>

                        <section id="section-rest-api">
                            <h1 class="h3 my-3 text-gray-800">RestAPI Description:</h1>
                            <ul>
                                <li>
                                    Endpoint: /FPS/CheckTransaction
                                </li>
                                <li>
                                    Method: POST
                                </li>
                                <li>
                                    Object model:
                                </li>
                                <li>
                                    <ul>
                                        <li>
                                            Account → Login name
                                        </li>
                                        <li>
                                            Subscriber → Subscriber Name which provided from FPS team
                                        </li>
                                        <li>
                                            SubscriberDate → Get NOW date
                                        </li>
                                        <li>
                                            DI → Get value from hidden element “__di”, default empty value
                                        </li>
                                        <li>
                                            BI → Get value from hidden element “__bi”, default empty value
                                        </li>
                                        <li>
                                            IP → Get client IP
                                        </li>
                                        <li>
                                            UserAgent → Get UserAgent from http header
                                        </li>
                                        <li>
                                            DetecasAnalysis → Get value from hidden element “detecas-analysis”, default empty value
                                        </li>
                                        <li>
                                            Action → “Login”
                                        </li>
                                        <li>
                                            ActionResult → “Successfull”
                                        </li>
                                        <li>
                                            AcceptsTypes → Get value from http header “Accept”
                                        </li>
                                        <li>
                                            SessionKey → Get value from hidden element “__fdi”, default empty value
                                        </li>
                                        <li>
                                            Token → Get value from hidden element “tk”, default empty value
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                            <div class="col-12 font-weight-bold">
                                Ex: Please refer to 
                                <a href="@Url.Action("DownloadFile", "Home", new { fileName = "RestAPI.Example.txt" })" class="btn-link">RestAPI.Example.txt</a>
                            </div>
                        </section>
                    </div>
                    <!-- /.container-fluid -->

                </div>
                </div>
        </div>
    </div>
</div>

<script>
    function scrollToSection(sectionId) {
        var section = document.getElementById(sectionId);
        // Scroll đến vị trí
        window.scrollTo({
            top: section.offsetTop - 0,
            behavior: 'smooth' // Tạo hiệu ứng cuộn mượt
        });
    }
</script>