@model SubscriberModel
@{
    ViewData["Title"] = "Home Page";
    var frontend = ViewBag.FrontEnd;
}

<style>
    .grid-container {
        display: flex;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px; /* Khoảng trống giữa các cột */
    }

    .grid-item {
        display: flex;
        padding: 16px;
    }
</style>
<div class="text-center row">
    <div class="col-md-12">
        <section>
            <form method="post" role="form" class="form-horizontal" action="@Url.Action("OnPost")">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="grid-container">
                    <div class="grid-item">
                        <div class="font-weight-bold align-self-center">
                            Choose Subscriber:
                        </div>
                        <div class="ml-2">
                            @Html.DropDownListFor(m => m.SubscriberId, ViewBag.SubscriberList as SelectList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="grid-item">
                        <div class="ml-2">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </div>
            </form>

            <div class="d-flex mt-2 control-label text-left border bg-info">
                <div class="mr-auto p-2 text-white">
                    Front-end PROD
                </div>
                <div class="p-2">
                    <button class="btn-copy-front-end-prod" data-clipboard-target="#front-end-prod">
                        <img width="13" src="~/assets/clippy.svg" alt="Copy to clipboard">
                    </button>
                </div>
            </div>
            <pre class="tag-pre"><code class="language-html" id="front-end-prod">@ViewBag.FrontEndProd</code></pre>

            <div class="d-flex mt-2 control-label text-left border bg-info">
                <div class="mr-auto p-2 text-white">
                    Front-end UAT
                </div>
                <div class="p-2">
                    <button class="btn-copy-front-end-uat" data-clipboard-target="#front-end-uat">
                        <img width="13" src="~/assets/clippy.svg" alt="Copy to clipboard">
                    </button>
                </div>
            </div>
            <pre class="tag-pre"><code class="language-html" id="front-end-uat">@ViewBag.FrontEndUat</code></pre>



            <div class="d-flex mt-2 control-label text-left border bg-info">
                <div class="mr-auto p-2 text-white">
                    .Net Standard
                </div>
                <div class="p-2">
                    <button class="btn-copy-back-end" data-clipboard-target="#back-end">
                        <img width="13" src="~/assets/clippy.svg" alt="Copy to clipboard">
                    </button>
                </div>
            </div>
            <pre class="tag-pre"><code class="language-csharp" id="back-end">@ViewBag.BackEndNetStandard</code></pre>


            <div class="d-flex mt-2 control-label text-left border bg-info">
                <div class="mr-auto p-2 text-white">
                    .Net Core
                </div>
                <div class="p-2">
                    <button class="btn-copy-back-end" data-clipboard-target="#back-end">
                        <img width="13" src="~/assets/clippy.svg" alt="Copy to clipboard">
                    </button>
                    <button class="btn-copy-back-end" data-clipboard-target="#back-end">
                        <img width="13" src="~/assets/download-svgrepo-com.svg" alt="Copy to clipboard">
                    </button>
                </div>
            </div>
            <pre class="tag-pre"><code class="language-csharp" id="back-end">@ViewBag.BackEndNetCore</code></pre>


            <div class="d-flex mt-2 control-label text-left border bg-info">
                <div class="mr-auto p-2 text-white">
                    .Net Framework
                </div>
                <div class="p-2">
                    <button class="btn-copy-back-end" data-clipboard-target="#back-end">
                        <img width="13" src="~/assets/clippy.svg" alt="Copy to clipboard">
                    </button>
                    <button class="btn-copy-back-end" data-clipboard-target="#back-end">
                        <a href="@Url.Action("DownloadScriptFile", "Home")" class="btn-link">
                            <img width="13" src="~/assets/download-alt-svgrepo-com.svg" alt="Copy to clipboard"> Download Script
                        </a>
                    </button>
                </div>
            </div>
            <pre class="tag-pre"><code class="language-csharp" id="back-end">@ViewBag.BackEndNetFramework</code></pre>

        </section>
    </div>
</div>

<script>
    new ClipboardJS('.btn-copy');
</script>

<script>

    // Tooltip frontend PROD
    $('.btn-copy-front-end-prod').tooltip({
        trigger: 'click',
        placement: 'bottom'
    });

    function setTooltipFrontEndProd(message) {
        $('.btn-copy-front-end-prod').tooltip('hide')
            .attr('data-original-title', message)
            .tooltip('show');
    }

    function hideTooltipFrontEndProd() {
        setTimeout(function () {
            $('.btn-copy-front-end-prod').tooltip('hide');
        }, 1000);
    }

    var clipboardFrontEndProd = new ClipboardJS('.btn-copy-front-end-prod');

    clipboardFrontEndProd.on('success', function (e) {
        setTooltipFrontEndProd('Copied!');
        hideTooltipFrontEndProd();

    });

    clipboardFrontEndProd.on('error', function (e) {
        setTooltipFrontEndProd('Failed!');
        hideTooltipFrontEndProd();

    });

    // Tooltip frontend UAT
    $('.btn-copy-front-end-uat').tooltip({
        trigger: 'click',
        placement: 'bottom'
    });

    function setTooltipFrontEndUAT(message) {
        $('.btn-copy-front-end-uat').tooltip('hide')
            .attr('data-original-title', message)
            .tooltip('show');
    }

    function hideTooltipFrontEndUAT() {
        setTimeout(function () {
            $('.btn-copy-front-end-uat').tooltip('hide');
        }, 1000);
    }

    var clipboardFrontEndUAT = new ClipboardJS('.btn-copy-front-end-uat');

    clipboardFrontEndUAT.on('success', function (e) {
        setTooltipFrontEndUAT('Copied!');
        hideTooltipFrontEndUAT();

    });

    clipboardFrontEndUAT.on('error', function (e) {
        setTooltipFrontEndUAT('Failed!');
        hideTooltipFrontEndUAT();

    });

    

    // Tooltip backend

    $('.btn-copy-back-end').tooltip({
        trigger: 'click',
        placement: 'bottom'
    });

    function setTooltipBackEnd(message) {
        $('.btn-copy-back-end').tooltip('hide')
            .attr('data-original-title', message)
            .tooltip('show');
    }

    function hideTooltipBackEnd() {
        setTimeout(function () {
            $('.btn-copy-back-end').tooltip('hide');
        }, 1000);
    }

    var clipboardBackEnd = new ClipboardJS('.btn-copy-back-end');

    clipboardBackEnd.on('success', function (e) {
        setTooltipBackEnd('Copied!');
        hideTooltipBackEnd();

    });

    clipboardBackEnd.on('error', function (e) {
        setTooltipBackEnd('Failed!');
        hideTooltipBackEnd();

    });
</script>