                        <section>
                            <h1 class="h3 my-3 text-gray-800">RestAPI</h1>
                            <ul>
                                <li>
                                    <span class="text-primary">Endpoint</span>: /FPS/CheckTransaction
                                </li>
                                <li>
                                    <span class="text-primary">Method</span>: POST
                                </li>
                                <li>
                                    <span class="font-weight-bold">Object model</span>:
                                </li>
                                <li style="list-style-type:none">
                                    <ul>
                                        <li>
                                            <span class="text-primary">Account</span> → Login name
                                        </li>
                                        <li>
                                            <span class="text-primary">Subscriber</span> → Subscriber Name which provided from FPS team
                                        </li>
                                        <li>
                                            <span class="text-primary">SubscriberDate</span> → Get NOW date
                                        </li>
                                        <li>
                                            <span class="text-primary">DI</span> → Get value from hidden element “__di”, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">BI</span> → Get value from hidden element “__bi”, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">IP</span> → Get client IP
                                        </li>
                                        <li>
                                            <span class="text-primary">UserAgent</span> → Get UserAgent from http header
                                        </li>
                                        <li>
                                            <span class="text-primary">DetecasAnalysis</span> → Get value from hidden element “detecas-analysis”, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">Action</span> → “Login”
                                        </li>
                                        <li>
                                            <span class="text-primary">ActionResult</span> → “Successfull”
                                        </li>
                                        <li>
                                            <span class="text-primary">AcceptsTypes</span> → Get value from http header “Accept”
                                        </li>
                                        <li>
                                            <span class="text-primary">SessionKey</span> → Get value from hidden element “__fdi”, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">Token</span> → Get value from hidden element “tk”, default empty value
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                            <div class="col-12 font-weight-bold pb-2">
                                Ex: Please refer to RestAPI Example:
                            </div>
                            <div class="card-body">
                                <pre class="tag-pre"><code class="language-javascript">
var data = JSON.stringify({
  "Account": "TestJo0101",
  "Subscriber": "Alpha",
  "SubscriberDate": "11/21/2023 4:47:40 PM",
  "DI": "",
  "BI": "",
  "IP": "127.0.0.1",
  "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36",
  "DetecasAnalysis": "{\"startTime\":1700560192636,\"version\":\"2.0.17\",\"exceptions\":[],\"executions\":[],\"storages\":[],\"devices\":[],\"enable\":true}",
  "Action": "Login",
  "ActionResult": "Successfull",
  "AcceptsTypes": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
  "SessionKey": "f622fa1a8eb347a694fa6e965905b7b3",
  "Token": "",
  "Url": "http://www.ultra88.com"
});

var xhr = new XMLHttpRequest();
xhr.withCredentials = true;

xhr.addEventListener("readystatechange", function() {
  if(this.readyState === 4) {
    console.log(this.responseText);
  }
});

xhr.open("POST", "http://api.detecas.com/FPS/CheckTransaction");
xhr.setRequestHeader("Content-Type", "application/json");

xhr.send(data);
                                </code></pre>
