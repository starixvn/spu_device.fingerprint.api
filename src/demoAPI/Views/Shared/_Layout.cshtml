<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title</title>

	<link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
	<link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

	<!-- Custom styles for this template-->
	<link href="~/Content/css/sb-admin-2.css" rel="stylesheet">

	<link href="~/Content/css/prism.css" rel="stylesheet" />
</head>
<body>
	@if (Session["Username"] != null)
	{
		<div class="navbar navbar-inverse navbar-fixed-top">
			<div class="container">
				<div class="navbar-header">
					<button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
					</button>
				</div>
				<div class="navbar-collapse collapse">
					@Html.AntiForgeryToken()
					<ul class="nav navbar-nav navbar-right">
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="">Username: <b>@Session["Username"].ToString()</b></a>
						</li>
						<li><a href="@Url.Action("Logout","Login")" class="btn ">Logout</a></li>
					</ul>
				</div>
			</div>
		</div>
	}
	<main role="main" class="pb-3">@RenderBody()</main>
</body>
</html>
