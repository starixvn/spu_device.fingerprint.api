@model demoAPI.Models.LoginModel

<div class="row">
    <div class="col-md-8">
        <section>
            <form method="post" role="form" class="form-horizontal" action="@Url.Action("OnPost", "Login")">
                @Html.AntiForgeryToken()

                <h4>Use a local account to log in.</h4>
                <hr />

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Username, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="submit" class="btn btn-default">Log in</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
    
</div>
<div>
    RealIP:
    @Model.RealIP


</div>
<div>
    FakeIP:
    @Model.FakeIP

</div>
<div>
    XForwarded:
    @Model.XForwarded

</div>
<div>
    XActualIP:
    @Model.XActualIP

</div>
<script async defer src="@System.Configuration.ConfigurationManager.AppSettings["externalAPIUrl"].ToString()/api/scr/demo" type="text/javascript"></script>
