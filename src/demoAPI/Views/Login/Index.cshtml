@model demoAPI.Models.LoginModel
@{
    ViewBag.Title = "demoAPI - Simple Login Page";
    var UrlContext = ViewBag.UrlContext;
    var Host = UrlContext == null ? "" : UrlContext.Host;
    var Port = UrlContext == null ? "" : UrlContext.Port;
    var AbsolutePath = UrlContext == null ? "" : UrlContext.AbsolutePath;
    var AbsoluteUri = UrlContext == null ? "" : UrlContext.AbsoluteUri;
    var OriginalString = UrlContext == null ? "" : UrlContext.OriginalString;
    var Scheme = UrlContext == null ? "" : UrlContext.Scheme;


    var UrlReferrerContext = ViewBag.UrlReferrerContext;
    var SchemeR = UrlReferrerContext == null ? "" : UrlReferrerContext.Scheme;
    var AbsoluteUriR = UrlReferrerContext == null ? "" : UrlReferrerContext.AbsoluteUri;
    var OriginalStringR = UrlReferrerContext == null ? "" : UrlReferrerContext.OriginalString;
}

<h2>@ViewBag.Title.</h2>
<h2>AbsoluteUri: @AbsoluteUri</h2>
<h2>OriginalString: @OriginalString</h2>
<h2>Scheme: @Scheme</h2>
<h1>UrlReferrer:</h1>
<h2>SchemeR: @SchemeR</h2>
<h2>AbsoluteUriR: @AbsoluteUriR</h2>
<h2>OriginalStringR: @OriginalStringR</h2>

<div class="row">
    <div class="col-md-8">
        <section>
            <form method="post" role="form" class="form-horizontal" action="@Url.Action("OnPost", "Login")">
                @Html.AntiForgeryToken()

                <h4>Use a local account to log in.</h4>
                <hr />

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Username, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="submit" class="btn btn-default">Log in</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

<script async defer src="@System.Configuration.ConfigurationManager.AppSettings["externalAPIUrl"].ToString()/api/scr/demo" type="text/javascript"></script>