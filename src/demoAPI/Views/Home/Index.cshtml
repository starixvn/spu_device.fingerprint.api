@{
	ViewBag.Title = "FPS API Guide";
	var hideLocalField = false;

	if (Context.Request.Url.ToString().Contains("nexdev") || Context.Request.Url.IsLoopback)
	{
		hideLocalField = true;
	}
}
<div class="container-fluid">
	<div class="row">
		<div class="col-2 px-1 position-fixed" id="sticky-sidebar">
			<div class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

				<div class="sidebar-brand d-flex align-items-center justify-content-center">
					<div class="sidebar-brand-text">FPS Integration Site</div>
				</div>
				<hr class="sidebar-divider">

				<div class="sidebar-heading cursor-pointer pb-2" onclick="scrollToSection('section-top')">
					Client-Side Integration
				</div>
				<hr class="sidebar-divider">

				<div class="sidebar-heading cursor-pointer pb-2" onclick="scrollToSection('section-rest-api')">
					Rest API
				</div>
				<hr class="sidebar-divider">

				<div class="sidebar-heading cursor-pointer" onclick="scrollToSection('section-server-side')">
					Server-Side Integration
				</div>

				<div class="nav-item">
					<div class="nav-link cursor-pointer" onclick="scrollToSection('section-server-side')">
						<i class="fas fa-angle-double-right"></i>
						<span>.Net Standard</span>
					</div>
					<div class="nav-link cursor-pointer" onclick="scrollToSection('section-net-core')">
						<i class="fas fa-angle-double-right"></i>
						<span>.Net Core</span>
					</div>
					<div class="nav-link cursor-pointer" onclick="scrollToSection('section-net-framework')">
						<i class="fas fa-angle-double-right"></i>
						<span>.Net Framework</span>
					</div>
				</div>
			</div>
		</div>
		<div class="col-10 offset-2 outer-container" id="main">
			<section id="section-top">
				<div class="m-4 p-3 navbar-light bg-white shadow">
					<div class="row">
						<div class="col-4">
							SessionKey: <span id="id-session-key" class="text-primary"></span>
						</div>
						<div class="col-8">
							Ip Address: <span id="id-ip-address" class="text-primary">@Request.ServerVariables["LOCAL_ADDR"]</span>
						</div>
					</div>
					<div class="row">
						<div class="col-12">
							User Agent: <span id="id-user-agent" class="text-primary">&lt;User-Agent string&gt;</span>
						</div>
					</div>
				</div>
			</section>
			<div id="content-wrapper" class="d-flex flex-column">
				<div id="content" class="h-100 d-inline-block">
					<div class="container-fluid">

						@* Client-Side Integration *@
						<section>
							<h1 class="h3 my-3 text-gray-800">Client-Side Integration</h1>
						</section>
						<section>
							<div class="row ml-0">
								<div class="card shadow mb-4 w-100">
									<div class="card-header py-3">
										<h6 class="m-0 font-weight-bold text-primary">HTML</h6>
									</div>
									<div class="card-body">
										<pre class="tag-pre"><code class="language-javascript">&lt;script type="text/javascript" src="{activatorLink}" async="" defer=""&gt;&lt;/script&gt;</code></pre>
									</div>
								</div>
							</div>
							<div class="row">
								<p class="col-12">
									With <span class="text-primary">{activatorLink}</span> is:
								</p>
								<ul>
									<li>
										PROD: <span class="text-primary">//sc.detecas.com/di/activator.ashx</span>
									</li>
									<li>
										STAGGING: <span class="text-primary">//scqa2.detecas.com/activator.ashx</span>
									</li>

									@if (hideLocalField)
									{
										<li>
											LOCAL: <span class="text-primary">//fps-di.nexdev.net/activator.ashx</span>
										</li>
									}
								</ul>
							</div>
						</section>

						<hr />

						@* Rest API *@

						<section id="section-rest-api">
							<h1 class="h3 my-3 text-gray-800">Rest API</h1>
							<ul>
								<li>
									<span class="text-primary">Endpoint</span>: /FPS/CheckTransaction
								</li>
								<li style="list-style-type:none">
									<ul>
										<li>
											PROD
											<ul>
												<li>
													Internal network: <span class="text-primary">http://fpsapi.nebula.prod</span>
												</li>
												<li>
													External network: <span class="text-primary">https://api.detecas.com</span>
												</li>
											</ul>
										</li>
										<li>
											STAGGING
											<ul>
												<li>
													Internal network: <span class="text-primary">http://fpt-uat.nebula.prod</span>
												</li>
												<li>
													External network: <span class="text-primary">https://fpt-uat.starixuat.com:6012</span>
												</li>
											</ul>
										</li>

										@if (hideLocalField)
										{
											<li>
												LOCAL: <span class="text-primary">https://fps-newapi.nexdev.net/</span>
											</li>
										}
									</ul>
								</li>
								<li>
									<span class="text-primary">Method</span>: POST
								</li>
								<li>
									<span class="font-weight-bold">Object model</span>:
								</li>
								<li style="list-style-type:none">
                                    <ul>
                                        <li>
                                            <span class="text-primary">Account</span> → Login name
                                        </li>
                                        <li>
                                            <span class="text-primary">Subscriber</span> → Subscriber Name which provided from FPS team
                                        </li>
                                        <li>
                                            <span class="text-primary">SubscriberDate</span> → Get <b>NOW</b> date
                                        </li>
                                        <li>
                                            <span class="text-primary">DI</span> → Get value from hidden element <b>“__di”</b>, default empty value
                                        </li>                                      
                                        <li>
                                            <span class="text-primary">BI</span> → Get value from hidden element <b>“__bi”</b>, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">IP</span> → Get client IP
                                        </li>
                                        <li>
                                            <span class="text-primary">UserAgent</span> → Get UserAgent from http header
                                        </li>
                                        <li>
                                            <span class="text-primary">DetecasAnalysis</span> → Get value from hidden element <b>“detecas-analysis”</b>, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">Action</span> → <b>“Login”</b>
                                        </li>
                                        <li>
                                            <span class="text-primary">ActionResult</span> → <b>“Successfull”</b>
                                        </li>                                       
                                        <li>
                                            <span class="text-primary">SessionKey</span> → Get value from hidden element <b>“__fdi”</b>, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">Token</span> → Get value from hidden element <b>“tk”</b>, default empty value
                                        </li>
                                        <li>
                                            <span class="text-primary">Url</span> → Get current url
                                        </li>
                                    </ul>
								</li>
							</ul>
							<div class="col-12 font-weight-bold pb-2">
								Ex: Please refer to RestAPI Example:
							</div>
							<div class="card-body">
								<pre class="tag-pre"><code class="language-javascript" id="id-code-content">
	var data = {
	"Account": "TestJo0101",
	"Subscriber": "SubTest",
	"SubscriberDate": "11/21/2023 4:47:40 PM",
	"DI": "__di__",
	"BI": "__bi__",
	"IP": "@Request.ServerVariables["LOCAL_ADDR"]",
	"UserAgent": "__useragent__",
	"DetecasAnalysis": "__detecasAnalysis__",
	"Action": "Login",
	"ActionResult": "Successfull",
	"SessionKey": "__sessionKey__",
	"Token": "",
	"Url": "__url__"
	};

</code></pre>
							</div>
						</section>

						<hr />


						@* Server-Side Integration *@
						<section id="section-server-side">
							<h1 class="h3 my-3 text-gray-800">Server-Side Integration</h1>
						</section>
						<section>
							<div class="row">
								<p class="col-12">
									Step1: Install/Update new SDK
								</p>
								<p class="col-12">
									Step2: Change to new code
								</p>
							</div>
							<div class="row ml-0">
								<div class="card shadow mb-4 w-100">
									<div class="card-header py-3 d-flex justify-content-between align-items-center">
										<h6 class="m-0 font-weight-bold text-primary">.Net Standard</h6>

										<a href="@Url.Action("DownloadFile", "Home", new { fileName = "FPS.Client.NetStandard.zip" })" class="btn-link">
											(Download File SDK <img width="13" src="~/Content/assets/download-alt-svgrepo-com.svg" alt="Copy to clipboard">)
										</a>
									</div>
									<div class="card-body">
										<pre class="tag-pre">
										<code class="language-javascript">
var fpsClient = new FPS.Client.NetStandard.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
									</div>
								</div>
							</div>
						</section>


						<section id="section-net-core">
							<div class="row ml-0">
								<div class="card shadow mb-4 w-100">
									<div class="card-header py-3 d-flex justify-content-between align-items-center">
										<h6 class="m-0 font-weight-bold text-primary">.Net NetCore</h6>

										<a href="@Url.Action("DownloadFile", "Home", new { fileName = "FPS.Client.NetCore.zip" })" class="btn-link">
											(Download File SDK <img width="13" src="~/Content/assets/download-alt-svgrepo-com.svg" alt="Copy to clipboard">)
										</a>
									</div>
									<div class="card-body">
										<pre class="tag-pre">
										<code class="language-javascript">
var fpsClient = new FPS.Client.NetCore.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
									</div>
								</div>
							</div>
						</section>

						<section id="section-net-framework">
							<div class="row ml-0">
								<div class="card shadow mb-4 w-100">
									<div class="card-header py-3 d-flex justify-content-between align-items-center">
										<h6 class="m-0 font-weight-bold text-primary">.Net Framework</h6>

										<a href="@Url.Action("DownloadFile", "Home", new { fileName = "FPS.Client.zip" })" class="btn-link">
											(Download File SDK <img width="13" src="~/Content/assets/download-alt-svgrepo-com.svg" alt="Copy to clipboard">)
										</a>
									</div>
									<div class="card-body">
										<pre class="tag-pre">
										<code class="language-javascript">
var fpsClient = new FPS.Client.Service();
fpsClient.InitialRequest({fpsAPI}, {httpRequest})
        .CheckTransaction({loginName}, {subscriberName}, {action}, {loginTime});</code>
                                        </pre>
									</div>
								</div>
							</div>
						</section>

						<div class="row">
							<p class="col-12">
								With <span class="text-primary">{fpsAPI}</span> is:
							</p>
							<ul>
								<li style="list-style-type:none">
									<ul>
										<li>
											<b>PROD</b>
											<ul>
												<li>
													Internal network: <span class="text-primary">http://fpsapi.nebula.prod</span>
												</li>
												<li>
													External network: <span class="text-primary">https://api.detecas.com</span>
												</li>
											</ul>
										</li>
										<li>
											<b>STAGGING</b>
											<ul>
												<li>
													Internal network: <span class="text-primary">http://fpt-uat.nebula.prod</span>
												</li>
												<li>
													External network: <span class="text-primary">https://fpt-uat.starixuat.com:6012</span>
												</li>
											</ul>
										</li>

										@if (hideLocalField)
										{
											<li>
												<b>LOCAL</b>: <span class="text-primary">https://fps-newapi.nexdev.net/</span>
											</li>
										}
									</ul>
								</li>
							</ul>
						</div>

						<div class="row">
							<p class="col-12">
								And parameters:
							</p>
							<ul>
								<li>
									<span class="text-primary">{loginName}</span>: The username that the client uses to log in.
								</li>
								<li>
									<span class="text-primary">{subscriberName}</span>: The licensee’s name that provided by FPS team.
								</li>
								<li>
									<span class="text-primary">{action}</span>: The action where fps integrated (login, deposit, withdraw, etc.).
								</li>
								<li>
									<span class="text-primary">{loginTime}</span>: The time when the client logged in successfully.
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<script async="" defer="" src="//sc.detecas.com/di/activator.ashx"></script>

<script>
	function scrollToSection(sectionId) {
		var section = document.getElementById(sectionId);
		window.scrollTo({
			top: section.offsetTop - 20,
			behavior: 'smooth'
		});
	}

	window.onload = function () {
		var sessionKeyElement = document.getElementById("id-session-key");

		var fdiValueElement = document.getElementById("__fdi");
		var diHiddenElement = document.getElementById("__di");
		var biHiddenElement = document.getElementById("__bi");
		var detecasAnalysisElement = document.getElementById("detecas-analysis");
		var userAgentElement = document.getElementById("id-user-agent");

		if (sessionKeyElement && fdiValueElement) {
			sessionKeyElement.innerHTML = fdiValueElement.value;
		}
		if (userAgentElement) {
			userAgentElement.innerHTML = navigator.userAgent;
		}

		var contentElement = document.getElementById("id-code-content");
		if (contentElement) {
			var contentHtml = contentElement.innerHTML;

			if (diHiddenElement) {
				contentHtml = contentHtml.replace("__di__", diHiddenElement.value);
			}
			if (biHiddenElement) {
				contentHtml = contentHtml.replace("__bi__", biHiddenElement.value);
			}
			if (detecasAnalysisElement) {
				contentHtml = contentHtml.replace("__detecasAnalysis__", detecasAnalysisElement.value);
			}
			if (fdiValueElement) {
				contentHtml = contentHtml.replace("__sessionKey__", fdiValueElement.value);
			}
			else {
                contentHtml = contentHtml.replace("__sessionKey__", "7ab4f1fc185a4044b3f6e06e373f4d82:9");
			}

			contentHtml = contentHtml.replace("__useragent__", navigator.userAgent);
			contentHtml = contentHtml.replace("__url__", window.location.href);
			contentElement.innerHTML = contentHtml;
		}
	};
</script>


<!-- Bootstrap core JavaScript-->
<script src="~/Content/vendor/jquery/jquery.min.js"></script>
<script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- Core plugin JavaScript-->
<script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>

<!-- Custom scripts for all pages-->
<script src="~/Content/js/sb-admin-2.js"></script>
<script src="~/Content/js/prism.js"></script>