@model DemoNetCore.Models.LoginModel
@{
  ViewBag.Title = "DemoNetCore - Simple Login Page";
}

<h2>@ViewBag.Title.</h2>

<div class="row">
  <div class="col-md-8">
    <section>
      <form method="post" role="form" class="form-horizontal" action="@Url.Action("OnPost", "Login")">
        @Html.AntiForgeryToken()

        <h4>Use a local account to log in.</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
          @Html.LabelFor(m => m.Username, new { @class = "col-md-2 control-label" })
          <div class="col-md-10">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
          </div>
        </div>

        <div class="form-group">
          @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
          <div class="col-md-10">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
          </div>
        </div>
        <div class="form-group">
          <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-default">Log in</button>
          </div>
        </div>
         <input name="__fdi" id="__fdi" type="hidden" value="35d0e6f9189b4658b299652f58f2ee1e:8">
      </form>
    </section>
  </div>
</div>
<script async defer src="@ViewBag.GetAPIUrl" type="text/javascript"></script>
<script src="@ViewBag.GetActivatorUrl" type="text/javascript" async defer></script>